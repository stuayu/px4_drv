# Kbuild for px4_drv

DEBUG := 0

PX4_USB_MAX_DEVICE := 0
PXMLT5_USB_MAX_DEVICE := 0
PXMLT8_USB_MAX_DEVICE := 0
ISDB2056_USB_MAX_DEVICE := 0
ISDB6014_4TS_USB_MAX_DEVICE := 0
PXM1UR_USB_MAX_DEVICE := 0
PXS1UR_USB_MAX_DEVICE := 0
ISDBT2071_USB_MAX_DEVICE := 0
PSB_DEBUG := 0
ITEDTV_BUS_USE_WORKQUEUE := 0

ccflags-y := -I$(M)/../include -I$(src) -I$(src)/linux -I$(src)/common/include -I$(src)/common/bridge -I$(src)/common/demod -I$(src)/common/tuner -I$(src)/common/ts -I$(src)/common/torne

ifneq ($(DEBUG),0)
ccflags-y += -DDEBUG -g
endif

ifneq ($(PX4_USB_MAX_DEVICE),0)
ccflags-y += -DPX4_USB_MAX_DEVICE=$(PX4_USB_MAX_DEVICE)
endif
ifneq ($(PXMLT5_USB_MAX_DEVICE),0)
ccflags-y += -DPXMLT5_USB_MAX_DEVICE=$(PXMLT5_USB_MAX_DEVICE)
endif
ifneq ($(PXMLT8_USB_MAX_DEVICE),0)
ccflags-y += -DPXMLT8_USB_MAX_DEVICE=$(PXMLT8_USB_MAX_DEVICE)
endif
ifneq ($(ISDB2056_USB_MAX_DEVICE),0)
ccflags-y += -DISDB2056_USB_MAX_DEVICE=$(ISDB2056_USB_MAX_DEVICE)
endif
ifneq ($(ISDB6014_4TS_USB_MAX_DEVICE),0)
ccflags-y += -DISDB6014_4TS_USB_MAX_DEVICE=$(ISDB6014_4TS_USB_MAX_DEVICE)
endif
ifneq ($(PXM1UR_USB_MAX_DEVICE),0)
ccflags-y += -DPXM1UR_USB_MAX_DEVICE=$(PXM1UR_USB_MAX_DEVICE)
endif
ifneq ($(PXS1UR_USB_MAX_DEVICE),0)
ccflags-y += -DPXS1UR_USB_MAX_DEVICE=$(PXS1UR_USB_MAX_DEVICE)
endif
ifneq ($(ISDBT2071_USB_MAX_DEVICE),0)
ccflags-y += -DISDBT2071_USB_MAX_DEVICE=$(ISDBT2071_USB_MAX_DEVICE)
endif
# RHEL 9 などはカーネル版数を据え置いたまま、6.4 の class_create() の引数変更を取り込んでいる。
# 版数では判定できないため、ビルド対象カーネルのヘッダーの宣言で判定する。
ifneq ($(shell grep -s 'class_create(const char \*name)' $(srctree)/include/linux/device/class.h),)
ccflags-y += -DPTX_CLASS_CREATE_WITHOUT_OWNER
endif
# 同じく 6.2 の class の devnode の引数を const にした変更も、版数ではなくヘッダーの宣言で判定する。
ifneq ($(shell grep -s -F '(*devnode)(const struct device *dev, umode_t *mode)' $(srctree)/include/linux/device/class.h),)
ccflags-y += -DPTX_CLASS_DEVNODE_CONST_DEVICE
endif
ifneq ($(PSB_DEBUG),0)
ccflags-y += -DPSB_DEBUG
endif
ifneq ($(ITEDTV_BUS_USE_WORKQUEUE),0)
ccflags-y += -DITEDTV_BUS_USE_WORKQUEUE
endif

obj-m := px4_drv.o
px4_drv-y := linux/driver_module.o linux/ptx_chrdev.o linux/px4_usb.o linux/px4_usb_params.o linux/px4_device.o linux/px4_device_params.o linux/px4_mldev.o linux/pxmlt_device.o linux/isdb2056_device.o common/bridge/it930x.o linux/itedtv_bus.o common/demod/tc90522.o common/tuner/r850.o common/tuner/rt710.o common/demod/cxd2856er.o common/demod/cxd2858er.o linux/ringbuffer.o linux/isdbt2071_device.o linux/px4_card.o common/ts/tsmf.o common/bridge/siano_wire_core.o common/bridge/siano_protocol_core.o linux/siano_device.o common/bridge/t230c_usb.o common/demod/si2168.o common/tuner/si2141.o common/ts/t230c_ts_sync.o linux/t230c_device.o common/torne/torne_bridge.o common/torne/torne_dib.o linux/torne_device.o
